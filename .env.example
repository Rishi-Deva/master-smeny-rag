# Скопируйте в .env и подставьте свои значения. Настоящие значения в git не кладите.
BOT_TOKEN=123456:replace-with-token-from-BotFather
# Telegram ID администраторов через запятую (команда /reindex)
ADMIN_IDS=111111111
OLLAMA_URL=http://localhost:11434
# Сколько секунд ждать ответа Ollama (на CPU ответ может идти долго)
OLLAMA_TIMEOUT=600
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=4096
EMBED_MODEL=bge-m3
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
# DEMO_MODE=1 — заглушки вместо Ollama (для demo.py и проверки без моделей)
DEMO_MODE=
